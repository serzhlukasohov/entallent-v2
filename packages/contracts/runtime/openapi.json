  "x-canonical-schema-source": {
    "source": "neutral-openapi-3.1",
    "decision": "Runtime HTTP contracts are owned by this OpenAPI 3.1 artifact. TypeScript and Python validators consume this artifact and shared fixtures; neither language-owned model is canonical.",
    "architectureDecision": "AD-14"
  },
  "paths": {
    "/runtime/process-message": {
      "post": {
        "operationId": "processRuntimeMessage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeProcessMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Runtime candidate result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeResult"
                }
              }
            }
          },
          "400": {
            "description": "Runtime contract or duplicate request error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Runtime dependency or availability error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RuntimeProcessMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
