{
  "name": "entalent",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "bash scripts/install-git-hooks.sh",
    "prepush": "pnpm typecheck && pnpm lint && pnpm test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "sim": "pnpm --filter @entalent/conversation-sim sim",
    "sim:gate": "pnpm --filter @entalent/conversation-sim sim:gate",
    "maf:shadow:smoke": "dotenv -e .env -- pnpm exec tsx scripts/live-maf-shadow-smoke.ts",
    "maf:primary:smoke": "dotenv -e .env -- pnpm exec tsx scripts/live-maf-primary-smoke.ts",
    "maf:primary:app:smoke": "dotenv -e .env -- pnpm exec tsx scripts/live-maf-primary-app-smoke.ts",
    "maf:primary:app:smoke:remote": "MAF_PRIMARY_APP_SMOKE_REMOTE=1 dotenv -e .env -- pnpm exec tsx scripts/live-maf-primary-app-smoke.ts",
    "maf:live:bootstrap": "bash scripts/maf-live-bootstrap.sh",
    "maf:live:slack:smoke": "bash scripts/maf-live-slack-smoke.sh",
    "maf:live:slack:smoke:full": "pnpm run maf:live:bootstrap && BOOTSTRAP_PREP=0 pnpm run maf:live:slack:smoke",
    "maf:live:slack:clean-ports": "bash scripts/maf-live-slack-clean-ports.sh",
    "maf:live:slack:dev": "API_PORT=${API_PORT:-3110} WORKER_PORT=${WORKER_PORT:-3111} SERVICE_PORT=${SERVICE_PORT:-18180} SKIP_SMOKE=1 sh -c 'pnpm run maf:live:bootstrap && BOOTSTRAP_PREP=0 SKIP_EVENT_SEND=1 KEEP_STACK_UP=1 pnpm run maf:live:slack:smoke'",
    "maf:live:slack:dev:ngrok": "START_NGROK=1 pnpm run maf:live:slack:dev",
    "maf:prod:acceptance": "bash scripts/maf-production-acceptance.sh",
    "maf:prod:regression": "bash scripts/maf-production-regression.sh",
    "maf:agent-service:readiness": "bash scripts/verify-agent-service-readiness.sh",
    "dashboard:prod:verify": "dotenv -e .env -- pnpm exec tsx scripts/verify-production-dashboard.ts",
    "db:generate": "pnpm --filter @entalent/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @entalent/database db:migrate",
    "db:seed": "dotenv -e .env -- pnpm exec tsx packages/database/src/seed.ts",
    "chat": "dotenv -e .env -- pnpm exec tsx scripts/chat.ts",
    "db:studio": "pnpm --filter @entalent/database db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@entalent/eslint-config": "workspace:*",
    "@entalent/typescript-config": "workspace:*",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.7",
    "dotenv-cli": "^7.4.4",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
